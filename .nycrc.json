{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "reporter": ["text", "html", "lcov"],
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "node_modules", "dist"],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
